    "schemas": {
      "AuthorityType": {
        "type": "string",
        "enum": [
          "municipality",
          "water_corporation",
          "fire_department",
          "home_front_command",
          "testing_lab",
          "surveyor",
          "soil_consultant",
          "structural_engineer",
          "supervising_engineer",
          "electrical_inspector",
          "gas_installer",
          "plumber",
          "green_building_lab",
          "contractor",
          "owner"
        ],
        "title": "AuthorityType"
      },
      "BuildState": {
        "properties": {
          "progress": {
            "$ref": "#/components/schemas/Progress"
