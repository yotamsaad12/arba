            "title": "Focus Floor"
          }
        },
        "type": "object",
        "required": [
          "progress",
          "stages",
          "focus_stage",
          "focus_floor"
        ],
        "title": "BuildState",
        "description": "Where construction stands, for progress visuals."
      },
      "Channel": {
