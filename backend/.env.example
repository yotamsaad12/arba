ARBA_ENV=dev
ARBA_DATABASE_URL=postgresql+asyncpg://arba:arba@localhost:5432/arba
ARBA_JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ARBA_INBOX_DOMAIN=in.arba.co.il
ARBA_COOKIE_SECURE=false

# Real email for testing through your own Gmail (needs an app password:
# https://myaccount.google.com/apppasswords). Without these, email goes to Mailpit.
# ARBA_SMTP_HOST=smtp.gmail.com
# ARBA_SMTP_PORT=587
# ARBA_SMTP_STARTTLS=true
# ARBA_SMTP_USER=you@gmail.com
# ARBA_SMTP_PASSWORD=<app password>
# ARBA_EMAIL_FROM=Arba <you@gmail.com>
# ARBA_EMAIL_ALLOWED_RECIPIENTS=["you@gmail.com"]
